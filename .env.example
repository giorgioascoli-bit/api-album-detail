# ==========================================
# Configurazione API Dettagli Album Discogs
# ==========================================

# Server
PORT=8000
HOST=0.0.0.0
DEBUG=false

# Discogs API (Opzionale ma altamente raccomandato per limiti di rate più alti)
# Ottieni un token personale gratuito su: https://www.discogs.com/settings/developers
DISCOGS_TOKEN=
DISCOGS_USER_AGENT=AlbumDetailAPI/1.0.0

# Modulo AI Opzionale (Google Gemini)
# Ottieni una chiave gratuita su: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Caching (in secondi, default: 24 ore = 86400)
CACHE_TTL_SECONDS=86400
